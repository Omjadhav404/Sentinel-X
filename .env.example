# ==========================================
# SentinelX Platform Configuration
# ==========================================

# Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scanner Provider Engine: 'local' (default) or 'external'
SCANNER_PROVIDER=local

# External Scanning Provider Integration (Optional)
# If using an external scanner microservice or third-party API (e.g. Mozilla Observatory, Qualys SSL Labs)
EXTERNAL_SCANNER_URL=https://api.external-scanner.example/v1/scan
EXTERNAL_SCANNER_API_KEY=your_secure_api_key_here

# Consultation & Security Incident Webhook (e.g. Slack, PagerDuty, Discord, or internal CRM)
CONSULTATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Notification Service (e.g. Resend, SendGrid, Amazon SES)
EMAIL_SERVICE_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
SECURITY_ALERTS_FROM_EMAIL=alerts@sentinelx.security
SECURITY_TEAM_EMAIL=incident-response@sentinelx.security

# Production Database (PostgreSQL / Prisma / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/sentinelx?schema=public

# Authentication (NextAuth.js / Supabase Auth / Clerk)
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
